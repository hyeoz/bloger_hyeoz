# Google AdSense Publisher ID (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_ID=your-adsense-id-here

# Naver Open API (https://developers.naver.com에서 발급)
# DataLab 쇼핑인사이트 API 사용을 위해 필요합니다
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Naver Search AD API (https://searchad.naver.com에서 발급)
# 키워드 검색량 조회를 위해 필요합니다
NAVER_SEARCHAD_CUSTOMER_ID=your-customer-id
NAVER_SEARCHAD_API_KEY=your-api-key
NAVER_SEARCHAD_SECRET_KEY=your-secret-key

# Gemini AI API Key
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Custom Search API (Optional - for in-page image search)
# Get API key from: https://console.cloud.google.com/apis/credentials
# Get CX from: https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_CX=your_search_engine_id_here
